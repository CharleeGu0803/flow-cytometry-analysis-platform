# Copy to .env and fill in. .env is git-ignored.

# Required in production; generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Optional overrides
# FLOW_DATA_DIR=/absolute/path/to/data
# DATABASE_URL=sqlite:////absolute/path/to/app.db
# FLOW_PANEL_CONFIG=/absolute/path/to/panel.json
